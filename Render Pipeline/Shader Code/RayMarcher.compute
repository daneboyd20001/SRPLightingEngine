// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSPrimaryRay
#pragma kernel CSAmbientOcclusion
#pragma kernel CSDiffuseRay

#include "SDFs.hlsl"
#include "RayHit.hlsl"
#include "Lighting.hlsl"

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float4> colorTex;
RWTexture2D<float4> depthTex;

uniform float4 ScreenSize;
uniform float4x4 CamToWorld;

uniform float MinClip;
uniform float MaxClip;
uniform float FOV_Tan;

uniform float quality;
uniform int maxSteps = 400;
uniform float secQuality;
uniform int secMaxSteps = 50;

static float PI = 3.14159;

float3 GetViewDir(int2 id)
{
    //normalized [-1,1]
    float2 uv = ((float2) id.xy) * ScreenSize.zw * 2.0 - 1;
    uv.x *= ScreenSize.x * ScreenSize.w;
    //Sampling a Sphere
    float3 rayDir = normalize(float3(uv * FOV_Tan, 1.0));
    return mul((float3x3) CamToWorld, rayDir);
}

[numthreads(8,8,1)]
void CSPrimaryRay(uint3 id : SV_DispatchThreadID)
{
    float3 rayDir = GetViewDir(id.xy);
    float3 camPos = CamToWorld._14_24_34;

    //Cone tracing, how large is pixel relative to screen
    float cutoff = .001 * quality;
    float dist = MinClip, distToScene;
    float3 pos = camPos + rayDir * dist;
    for (int i = 0; i < maxSteps; i++)
    {
        distToScene = SDF(pos) * quality;
        dist += distToScene;
        //This should converge slightly better
        pos = rayDir * dist + camPos;
        
        //use ABS to better converge for fractal geometries
        if (abs(distToScene) < max(cutoff * dist, cutoff))
            break;
        if (dist > MaxClip)
            break;
    }
    
    float3 normal = GetNormal(pos);
    depthTex[id.xy] = float4(normal, dist);
    colorTex[id.xy] = float4(CalculateLighting(pos, rayDir, normal, dist), 1.0);
    rayHit hit;
    hit.depth = dist;
    hit.normal = normal;
    hit.pixelID = id.x + id.y * ScreenSize.x;
    hit.position = pos;
    hitBufferRW[id.x + ScreenSize.x * id.y] = hit;
}

static const float AOScale[4] = { 0.125, 0.250, 0.500, 1.000 };
static const float3 AOKernel[32] =
{
    RNGHemisphere(1) * AOScale[0], RNGHemisphere(2) * AOScale[0], RNGHemisphere(3) * AOScale[0], RNGHemisphere(4) * AOScale[0],
    RNGHemisphere(5) * AOScale[0], RNGHemisphere(6) * AOScale[0], RNGHemisphere(7) * AOScale[0], RNGHemisphere(8) * AOScale[0],
    RNGHemisphere(9) * AOScale[1], RNGHemisphere(10) * AOScale[1], RNGHemisphere(11) * AOScale[1], RNGHemisphere(12) * AOScale[1],
    RNGHemisphere(13) * AOScale[1], RNGHemisphere(14) * AOScale[1], RNGHemisphere(15) * AOScale[1], RNGHemisphere(16) * AOScale[1],
    RNGHemisphere(17) * AOScale[2], RNGHemisphere(18) * AOScale[2], RNGHemisphere(19) * AOScale[2], RNGHemisphere(20) * AOScale[2],
    RNGHemisphere(21) * AOScale[2], RNGHemisphere(22) * AOScale[2], RNGHemisphere(23) * AOScale[2], RNGHemisphere(24) * AOScale[2],
    RNGHemisphere(25) * AOScale[3], RNGHemisphere(26) * AOScale[3], RNGHemisphere(27) * AOScale[3], RNGHemisphere(28) * AOScale[3],
    RNGHemisphere(29) * AOScale[3], RNGHemisphere(30) * AOScale[3], RNGHemisphere(31) * AOScale[3], RNGHemisphere(32) * AOScale[3],
};
[numthreads(16, 16, 1)]
void CSAmbientOcclusion(uint3 id : SV_DispatchThreadID)
{
    float3 pos = depthTex[id.xy].a * GetViewDir(id.xy) + CamToWorld._14_24_34;
    float3 normal = depthTex[id.xy].rgb;
    float3x3 basis = GetBasis(normal);

    float occlusion = 0.0;
    
    for (int i = 24; i < 32; i++)
    {
        float3 samplePos = pos + mul(AOKernel[i], basis);
        float t = SDF(samplePos);
        occlusion += saturate(t / AOScale[3]);
    }
    occlusion /= 2;
    for (i = 16; i < 24; i++)
    {
        float3 samplePos = pos + mul(AOKernel[i], basis);
        float t = SDF(samplePos);
        occlusion += saturate(t / AOScale[2]);
    }
    occlusion /= 4;
    for (i = 8; i < 16; i++)
    {
        float3 samplePos = pos + mul(AOKernel[i], basis);
        float t = SDF(samplePos);
        occlusion += saturate(t / AOScale[1]);
    }
    occlusion /= 6;
    for (i = 0; i < 8; i++)
    {
        float3 samplePos = pos + mul(AOKernel[i], basis);
        float t = SDF(samplePos);
        occlusion += saturate(t / AOScale[0]);
    }
    occlusion /= 8;

    float3 emission = colorTex[id.xy].xyz;
    emission *= occlusion;
    colorTex[id.xy] = float4(emission, 1);
}

static const float3 DKernel[64] =
{
    RNGCosHemisphere(7739), RNGCosHemisphere(9220), RNGCosHemisphere(9470), RNGCosHemisphere(6106),
    RNGCosHemisphere(5873), RNGCosHemisphere(3863), RNGCosHemisphere(226), RNGCosHemisphere(5962),
    RNGCosHemisphere(8845), RNGCosHemisphere(9432), RNGCosHemisphere(1457), RNGCosHemisphere(3143),
    RNGCosHemisphere(3468), RNGCosHemisphere(8272), RNGCosHemisphere(2376), RNGCosHemisphere(3661),

    RNGCosHemisphere(8218), RNGCosHemisphere(6370), RNGCosHemisphere(9380), RNGCosHemisphere(6267),
    RNGCosHemisphere(2011), RNGCosHemisphere(7921), RNGCosHemisphere(2606), RNGCosHemisphere(5927),
    RNGCosHemisphere(9910), RNGCosHemisphere(9592), RNGCosHemisphere(2902), RNGCosHemisphere(4402),
    RNGCosHemisphere(2566), RNGCosHemisphere(5800), RNGCosHemisphere(8204), RNGCosHemisphere(9847),

    RNGCosHemisphere(4847), RNGCosHemisphere(5163), RNGCosHemisphere(9750), RNGCosHemisphere(2657),
    RNGCosHemisphere(4712), RNGCosHemisphere(9761), RNGCosHemisphere(7876), RNGCosHemisphere(4786),
    RNGCosHemisphere(2401), RNGCosHemisphere(7445), RNGCosHemisphere(570), RNGCosHemisphere(9884),
    RNGCosHemisphere(7266), RNGCosHemisphere(3547), RNGCosHemisphere(846), RNGCosHemisphere(8421),

    RNGCosHemisphere(505), RNGCosHemisphere(5166), RNGCosHemisphere(9409), RNGCosHemisphere(9347),
    RNGCosHemisphere(5729), RNGCosHemisphere(1787), RNGCosHemisphere(2072), RNGCosHemisphere(6118),
    RNGCosHemisphere(1817), RNGCosHemisphere(6576), RNGCosHemisphere(6057), RNGCosHemisphere(4667),
    RNGCosHemisphere(7477), RNGCosHemisphere(3616), RNGCosHemisphere(1941), RNGCosHemisphere(9074),
};
//Diffuse only need 1 bounce
[numthreads(8, 8, 1)]
void CSDiffuseRay(uint3 id : SV_DispatchThreadID)
{
    rayHit hit = hitBuffer[id.x + ScreenSize.x * id.y];
    if (hit.pixelID == -1)
        return;
    
    float3 origin = hit.position;
    float3x3 basis = GetBasis(origin);
    float3 color = GetSurfaceColor(origin, GetNormal(origin));
    float3 finColor = float3(0, 0, 0);
    
    //Basically Copy Paste
    int sampleCount = 64;
    for (int z = 0; z < sampleCount; z++)
    {
        float3 rayDir = mul(basis, DKernel[z]);
        
        float cutoff = .01;
        float dist = 4.0, distToScene = 0;
        float3 pos = origin + rayDir; //Start far from the SDF, so you dont get stuck in it
        for (int i = 0; i < 16; i++) //40 is enough to converge for most scenes
        {
            pos = origin + rayDir * dist;
            distToScene = SDF(pos);
            dist += distToScene;
        
            if (abs(distToScene) < max(cutoff * dist, cutoff))
                break;
            if (dist > MaxClip)
                break;
        }
        finColor += CalculateLighting(pos, rayDir, GetNormal(pos), 1);
    }
    
    finColor *= color / float(sampleCount);
    finColor = finColor + colorTex[id.xy].rgb;
    colorTex[id.xy] = float4(finColor, 1.0);

}
